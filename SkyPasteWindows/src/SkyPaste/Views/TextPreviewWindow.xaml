<Window x:Class="SkyPaste.TextPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Preview" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,0">
            <TextBlock x:Name="PreviewTitle" Text="Text Preview" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" />
            <ContentControl x:Name="PreviewSource" Margin="0,4,0,0" HorizontalContentAlignment="Stretch" />
            <WrapPanel Margin="0,8,0,0">
                <Button Style="{DynamicResource CapsuleButton}" Click="OnShare" Margin="0,0,8,4">
                    <TextBlock x:Name="ShareLabel" />
                </Button>
                <Button x:Name="TranslateButton" Style="{DynamicResource CapsuleButton}" Click="OnTranslate" Margin="0,0,8,4">
                    <TextBlock x:Name="TranslateLabel" />
                </Button>
                <Button x:Name="FavoriteButton" Style="{DynamicResource CapsuleButton}" Click="OnFavorite">
                    <TextBlock x:Name="FavoriteLabel" Text="Favorite" />
                </Button>
                <Button x:Name="EmailButton" Style="{DynamicResource CapsuleButton}" Click="OnOpenEmail" Margin="8,0,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="EmailLabel" Text="Send Email" />
                </Button>
                <Button x:Name="BrowserButton" Style="{DynamicResource CapsuleButton}" Click="OnOpenBrowser" Margin="8,0,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="BrowserLabel" Text="Open in Browser" />
                </Button>
                <Button Style="{DynamicResource CapsuleButton}" Click="OnCopy" Margin="8,0,0,0">
                    <TextBlock x:Name="CopyLabel" Text="Copy" />
                </Button>
            </WrapPanel>
        </StackPanel>

        <TextBox x:Name="PreviewText" Grid.Row="1" Margin="14,10,14,12" Padding="16"
                 BorderThickness="0" Background="{DynamicResource SectionCard.Background}"
                 IsReadOnly="True" TextWrapping="Wrap" FontSize="14" VerticalScrollBarVisibility="Auto"
                 Foreground="{DynamicResource Text.Primary}" />
    </Grid>
</Window>
