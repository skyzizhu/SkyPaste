<UserControl x:Class="SkyPaste.Views.Controls.ClipboardListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="ListMenu" TargetType="ContextMenu">
            <Setter Property="MinWidth" Value="178" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource SectionCard.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="5"
                                RenderOptions.ClearTypeHint="Enabled">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListMenuEntry" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="EntryBackground" Background="Transparent" CornerRadius="6"
                                MinHeight="32" Padding="10,5,14,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock x:Name="SelectionMark" Grid.Column="2" Text="&#xE73E;"
                                           FontFamily="{DynamicResource GlyphFont}" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="EntryBackground" Property="Background" Value="{DynamicResource Row.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="EntryBackground" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="7,4" Background="{DynamicResource Divider}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="PanelHeader" Grid.Row="0" Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="BrandLogo" Width="38" Height="38" CornerRadius="9">
                <Border.Background>
                    <ImageBrush ImageSource="/SkyPaste;component/Assets/icon.png" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <StackPanel x:Name="BrandText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="SkyPaste" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}" />
                <TextBlock x:Name="HeaderHint" FontSize="11" Foreground="{DynamicResource Text.Secondary}"
                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SearchToggle" Style="{DynamicResource IconIconButton}"
                        Click="OnSearchToggleClick">
                    <TextBlock x:Name="SearchToggleGlyph" Text="&#xE71E;" FontSize="12" FontFamily="{DynamicResource GlyphFont}" />
                </Button>
                <Button x:Name="BatchToggle" Style="{DynamicResource IconIconButton}"
                        Click="OnBatchToggleClick" Margin="6,0,0,0">
                    <TextBlock Text="&#xE762;" FontSize="12" FontFamily="{DynamicResource GlyphFont}" />
                </Button>
                <Button x:Name="StatsToggle" Style="{DynamicResource IconIconButton}"
                        Click="OnStatsClick" Margin="6,0,0,0">
                    <TextBlock Text="&#xE9D2;" FontSize="12" FontFamily="{DynamicResource GlyphFont}" />
                </Button>
                <Button x:Name="CloseToggle" Style="{DynamicResource IconIconButton}"
                        Click="OnCloseClick" Margin="6,0,0,0">
                    <TextBlock Text="&#xE711;" FontSize="12" FontFamily="{DynamicResource GlyphFont}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Startup notice banner (mac startupNotice) -->
        <Border x:Name="StartupNoticeBar" Grid.Row="1" Margin="16,10,16,0" CornerRadius="12"
                Background="{DynamicResource AccentSoftBrush}" Padding="12,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="{DynamicResource GlyphFont}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="StartupNoticeText" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{DynamicResource IconIconButton}" Click="OnStartupNoticeClose">
                    <TextBlock Text="&#xE711;" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <!-- Search field -->
        <Border x:Name="SearchBar" Grid.Row="2" Margin="16,12,16,0" CornerRadius="14"
                Background="{DynamicResource SearchField.Background}"
                BorderBrush="{DynamicResource SearchField.Border}" BorderThickness="1"
                Padding="12,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE71E;" FontSize="12" FontFamily="{DynamicResource GlyphFont}"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,0,0" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource Text.Primary}"
                         FontSize="13" VerticalAlignment="Center"
                         TextChanged="OnSearchTextChanged" KeyDown="OnSearchBoxKeyDown" />
                <Button x:Name="SearchClear" Grid.Column="2" Style="{DynamicResource IconIconButton}"
                        Click="OnSearchClearClick" Visibility="Collapsed">
                    <TextBlock Text="&#xE894;" FontSize="11" FontFamily="{DynamicResource GlyphFont}" Foreground="{DynamicResource Text.Secondary}" />
                </Button>
            </Grid>
        </Border>

        <!-- Filter chips + source menu -->
        <Grid Grid.Row="3" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="FilterScroll" Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnFilterScroll">
                <StackPanel x:Name="FilterChips" Orientation="Horizontal" />
            </ScrollViewer>
            <Button x:Name="SourceMenuButton" Grid.Column="1" Margin="8,0,0,0"
                    Style="{DynamicResource CapsuleButton}" Click="OnSourceMenuClick" />
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="4" Margin="16,12,16,0">
            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SectionHost" />
            </ScrollViewer>
            <ContentControl x:Name="OverlayHost" Visibility="Collapsed" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="16,10,16,14">
            <WrapPanel x:Name="FooterNormal" />
            <UniformGrid x:Name="TrayFooter" Rows="1" Columns="4" Visibility="Collapsed" />
            <WrapPanel x:Name="FooterBatch" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
