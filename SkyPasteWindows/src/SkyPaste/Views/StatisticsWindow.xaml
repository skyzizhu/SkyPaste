<Window x:Class="SkyPaste.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard Insights">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="22,18,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleLabel" Text="Clipboard Insights" FontSize="23" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Primary}" />
            <TextBlock x:Name="SubtitleLabel" FontSize="11" Margin="0,2,0,0"
                       Foreground="{DynamicResource Text.Secondary}" />
        </StackPanel>

        <StackPanel x:Name="PeriodHost" Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Tag="0" Click="OnPeriodClick" Style="{DynamicResource CapsuleButton}" Margin="0,0,6,0">
                <TextBlock Text="Today" />
            </Button>
            <Button Tag="1" Click="OnPeriodClick" Style="{DynamicResource CapsuleButton}" Margin="0,0,6,0">
                <TextBlock Text="7 days" />
            </Button>
            <Button Tag="2" Click="OnPeriodClick" Style="{DynamicResource CapsuleButton}" Margin="0,0,6,0">
                <TextBlock Text="30 days" />
            </Button>
            <Button Tag="3" Click="OnPeriodClick" Style="{DynamicResource CapsuleButton}" Margin="0,0,6,0">
                <TextBlock Text="6 months" />
            </Button>
            <Button Tag="4" Click="OnPeriodClick" Style="{DynamicResource CapsuleButton}">
                <TextBlock Text="1 year" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Header.Background}" CornerRadius="16" Margin="0,0,6,0"
                    BorderBrush="{DynamicResource Card.Border}" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="TotalHeader" Text="Recorded copies" FontSize="10"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock x:Name="TotalValue" Text="0" FontSize="30" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource SectionCard.Background}" CornerRadius="16"
                    Margin="6,0,0,0" BorderBrush="{DynamicResource Card.Border}" BorderThickness="1" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="TopCategoryHeader" Text="Top category" FontSize="10"
                               Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock x:Name="TopCategory" Text="-" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="TrendHeader" Grid.Row="3" Text="Activity over time" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text.Primary}" Margin="0,14,0,6" />
        <Border Grid.Row="4" Background="{DynamicResource SectionCard.Background}" CornerRadius="14"
                Padding="12" Margin="0,0,0,0">
            <Canvas x:Name="TrendCanvas" Height="150" />
        </Border>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="BreakdownHeader" Text="By type" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6" />
                <Border Background="{DynamicResource SectionCard.Background}" CornerRadius="14" Padding="12">
                    <Grid>
                        <Canvas x:Name="DonutCanvas" Width="130" Height="130" HorizontalAlignment="Left" />
                        <StackPanel x:Name="DonutLegendHost" Margin="150,4,0,0" VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock x:Name="AppsHeader" Text="By source app" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6" />
                <Border Background="{DynamicResource SectionCard.Background}" CornerRadius="14" Padding="12">
                    <StackPanel x:Name="AppsHost" MinHeight="80" />
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="NoteText" Grid.Row="6" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource Text.Secondary}" />
    </Grid>
    </ScrollViewer>
</Window>
