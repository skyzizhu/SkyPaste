<UserControl x:Class="SkyPaste.Views.Controls.ImagePreviewWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,0">
            <DockPanel x:Name="WorkspaceHeading">
                <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Left" Text="Image Preview" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" />
                <TextBlock x:Name="PreviewSubtitle" DockPanel.Dock="Left" Margin="10,2,6,0" FontSize="11"
                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                <ContentControl x:Name="PreviewSource" Margin="0,2,0,0" HorizontalContentAlignment="Stretch" />
            </DockPanel>
            <WrapPanel x:Name="ImageActions" Margin="0,8,0,0">
                <Button Style="{DynamicResource CapsuleButton}" Click="OnShare" Margin="0,0,8,4">
                    <TextBlock x:Name="ShareLabel" />
                </Button>
                <Button Style="{DynamicResource CapsuleButton}" Click="OnOpenImage" Margin="0,0,8,4">
                    <TextBlock x:Name="OpenImageLabel" />
                </Button>
                <Button x:Name="FavoriteButton" Style="{DynamicResource CapsuleButton}" Click="OnFavorite">
                    <TextBlock x:Name="FavoriteButtonLabel" Text="Favorite" />
                </Button>
                <Button Style="{DynamicResource CapsuleButton}" Click="OnCopy" Margin="8,0,0,0">
                    <TextBlock x:Name="CopyButtonLabel" Text="Copy" />
                </Button>
                <Button Style="{DynamicResource CapsuleButton}" Click="OnSaveAs" Margin="8,0,0,0">
                    <TextBlock x:Name="SaveAsButtonLabel" Text="Save As..." />
                </Button>
                <Button x:Name="AnnotateButton" Style="{DynamicResource CapsuleButton}" Click="OnToggleAnnotate" Margin="8,0,0,0">
                    <TextBlock x:Name="AnnotateButtonLabel" Text="Annotate" />
                </Button>
            </WrapPanel>
        </StackPanel>

        <ScrollViewer x:Name="PreviewScroll" Grid.Row="1" Margin="14,10,14,0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="Transparent"
                      PreviewMouseWheel="OnPreviewMouseWheel"
                      PreviewMouseDown="OnPreviewMouseDown"
                      MouseMove="OnPreviewMouseMove"
                      PreviewMouseUp="OnPreviewMouseUp"
                      MouseDoubleClick="OnPreviewMouseDoubleClick">
            <Grid x:Name="AnnotationHost" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ImageScale" />
                </Grid.LayoutTransform>
                <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                <InkCanvas x:Name="AnnotationCanvas" Background="Transparent" EditingMode="None"
                           EditingModeInverted="None" IsHitTestVisible="False" Cursor="Cross" UseCustomCursor="True" />
            </Grid>
        </ScrollViewer>

        <WrapPanel x:Name="AnnotationToolbar" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="AnnotationHintLabel" FontSize="11"
                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel x:Name="ColorHost" Orientation="Horizontal">
                <Border Width="18" Height="18" CornerRadius="9" Tag="Red" Opacity="1" Margin="0,0,6,0"
                        Background="#E0453A" Cursor="Hand" MouseLeftButtonDown="OnPickColor" />
                <Border Width="18" Height="18" CornerRadius="9" Tag="Yellow" Opacity="0.45" Margin="0,0,6,0"
                        Background="#F5B825" Cursor="Hand" MouseLeftButtonDown="OnPickColor" />
                <Border Width="18" Height="18" CornerRadius="9" Tag="Blue" Opacity="0.45" Margin="0,0,6,0"
                        Background="#146BF0" Cursor="Hand" MouseLeftButtonDown="OnPickColor" />
                <Border Width="18" Height="18" CornerRadius="9" Tag="Black" Opacity="0.45" Margin="0,0,6,0"
                        Background="#111111" Cursor="Hand" MouseLeftButtonDown="OnPickColor" />
                <Border Width="18" Height="18" CornerRadius="9" Tag="Green" Opacity="0.45" Margin="0,0,10,0"
                        Background="#1F9E8C" Cursor="Hand" MouseLeftButtonDown="OnPickColor" />
            </StackPanel>
            <TextBlock x:Name="PenWidthLabel" FontSize="11" Foreground="{DynamicResource Text.Secondary}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <Slider x:Name="PenWidthSlider" Width="110" Minimum="2" Maximum="12" Value="4"
                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                    ValueChanged="OnPenWidthChanged" />
            <Button x:Name="UndoButton" Style="{DynamicResource CapsuleButton}" Click="OnUndoStroke"
                    IsEnabled="False" Margin="12,0,0,0">
                <TextBlock x:Name="UndoLabel" Text="Undo" />
            </Button>
            <Button x:Name="ClearButton" Style="{DynamicResource CapsuleButton}" Click="OnClearStrokes"
                    IsEnabled="False" Margin="8,0,0,0">
                <TextBlock x:Name="ClearLabel" Text="Clear" />
            </Button>
        </WrapPanel>

        <Grid Grid.Row="3" Margin="14,10,14,12">
            <TextBlock x:Name="DragHint" Text="Drag image out" FontSize="10"
                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="Fit" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <Button Style="{DynamicResource IconIconButton}" Click="OnZoomOut" Content="&#xE738;" FontFamily="{DynamicResource GlyphFont}" />
                <Button Style="{DynamicResource IconIconButton}" Click="OnZoomReset" Content="&#xE7A7;" FontFamily="{DynamicResource GlyphFont}" />
                <Button Style="{DynamicResource IconIconButton}" Click="OnZoomIn" Content="&#xE710;" FontFamily="{DynamicResource GlyphFont}" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="PreviewText" Grid.Row="1" Text="Preview unavailable" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Text.Secondary}" />
    </Grid>
</UserControl>
